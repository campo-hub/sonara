+@media (min-width: 1600px) {
+  html {
+    font-size: clamp(100%, calc(0.45vw + 55%), 250%);
+  }
+
+  body {
+    font-size: 0.9375rem;
+  }
+
+  .page {
+    width: min(94vw, 80rem);
+    padding: 2rem 2.5rem calc(10.625rem + env(safe-area-inset-bottom));
+  }
+
+  .banner {
+    min-height: 8.25rem;
+    margin-bottom: 2rem;
+    padding: 1.625rem 2.125rem;
+  }
+
+  .home-grid {
+    gap: 1.75rem;
+  }
+
+  .home-main {
+    gap: 2.25rem;
+  }
+
+  .home-panel {
+    padding: 1.125rem;
+  }
+
+  .sleeve-grid {
+    grid-template-columns: repeat(auto-fill, minmax(10.25rem, 1fr));
+    gap: 2.125rem 1.75rem;
+  }
+
+  .artist-grid {
+    grid-template-columns: repeat(auto-fill, minmax(10.625rem, 1fr));
+    gap: 2.125rem 1.625rem;
+  }
+
+  .scape-grid {
+    grid-template-columns: repeat(auto-fill, minmax(13.75rem, 1fr));
+    gap: 0.875rem;
+  }
+
+  .mix-shelf {
+    grid-auto-columns: minmax(9.75rem, 11.875rem);
+    gap: 1rem;
+  }
+
+  .collection-grid {
+    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
+    gap: 0.5rem;
+  }
+
+  .admin-count-grid {
+    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
+  }
+}
+
