# --- Required for uploads/catalog to work at all -----------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://your-bucket-public-domain.example.com

# --- Recommended: without this, catalog metadata is lost on every ------
# --- restart/redeploy (Render free tier spins down on inactivity). -----
MONGODB_URI=
MONGODB_DB_NAME=sonara

# --- Optional: auth is disabled (all requests anonymous/read-only for --
# --- personal library features) until these are set. -------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Required in production. Comma-separated list of exact origins -----
# --- allowed to call this API. Leave unset locally to allow all. -------
CORS_ORIGIN=https://your-username.github.io

# --- Optional: serve a small built-in sample catalog when the real -----
# --- catalog is empty (useful for demoing before any uploads exist). ---
SEED_FALLBACK_CATALOG=false

PORT=4000
